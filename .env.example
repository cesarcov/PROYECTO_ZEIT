# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — ZEIT Solutions ERP
#
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore y NUNCA se commitea (regla 6 de CONSTITUTION.md).
# Todos los valores de abajo son de EJEMPLO y no sirven en ningún entorno real.
#
# Cada clave declarada aquí existe en `app/core/config.py`. Si añades una nueva
# variable, decláralas en ambos sitios: el backend no arranca con variables no
# declaradas que sean obligatorias.
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | staging | production
ENV=development

# ── Seguridad / JWT ──────────────────────────────────────────────────────────
# OBLIGATORIA. Mínimo 32 caracteres. Genera una real con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-segura-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# ── Base de datos ────────────────────────────────────────────────────────────
# OBLIGATORIA. Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:clave@localhost:5432/erp_logistica
# Registro de tenants (multi-tenancy). Vacío = misma DB que DATABASE_URL.
MASTER_DATABASE_URL=

# ── Pool de conexiones ───────────────────────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=5

# ── Superadmin ───────────────────────────────────────────────────────────────
# Sus credenciales viven SOLO aquí, nunca en la base de datos de un tenant.
# Genera el par usuario/hash con: python scripts/generate_superadmin_hash.py
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD_HASH=$2b$12$EJEMPLO_FALSO_REEMPLAZAR_POR_HASH_REAL_BCRYPT

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes EXACTOS separados por comas, sin barra final. En desarrollo los
# puertos locales de Vite se añaden automáticamente.
CORS_ORIGINS=https://proyecto-zeit.vercel.app

# ── Observabilidad (Sentry) ──────────────────────────────────────────────────
# Vacío = Sentry desactivado (comportamiento por defecto en desarrollo).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Hash corto del commit desplegado. En Render se inyecta automáticamente.
GIT_COMMIT=dev

# ── Rate limiting de login ───────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5/minute
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60

# ── Almacenamiento persistente de archivos (Supabase Storage) ────────────────
# Vacío = disco local (EFÍMERO en Render: los logos se pierden al redesplegar).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_BRANDING=branding
SUPABASE_BUCKET_AVATARS=avatars

# ── SharePoint (integración opcional de reportes) ────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_NAME=
SHAREPOINT_FOLDER_PATH=Documentos compartidos/ERP_Reportes

# ── Credenciales para la suite de tests ──────────────────────────────────────
# Sin estas variables los tests que necesitan sesión se OMITEN (no fallan).
# Nunca uses aquí las credenciales de producción.
TEST_USER=
TEST_PASSWORD=
TEST_ADMIN_USER=
TEST_ADMIN_PASSWORD=
# Contraseña en claro del superadmin, solo para tests locales.
SUPERADMIN_PLAIN_PASSWORD=
