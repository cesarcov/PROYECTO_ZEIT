# ─────────────────────────────────────────────────────────────────────────────
# Variables del frontend (Vite) — ZEIT Solutions ERP
#
# Copia a `.env.local` para desarrollo. En Vercel se cargan como variables de
# entorno del proyecto. Todo lo que empieza por VITE_ queda EMBEBIDO en el
# bundle público: NUNCA pongas aquí un secreto de servidor.
# ─────────────────────────────────────────────────────────────────────────────

# URL del backend de FastAPI (ej. https://mi-erp-backend.onrender.com).
# Vacío o ausente = http://127.0.0.1:8000 (desarrollo local).
VITE_API_URL=

# Entorno mostrado en Sentry: development | staging | production
VITE_ENV=development

# ── Observabilidad (F-000 / T-04) ────────────────────────────────────────────
# Vacío = Sentry desactivado. El DSN de frontend es público por diseño.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Hash corto del commit desplegado; Vercel lo expone en VERCEL_GIT_COMMIT_SHA.
VITE_GIT_COMMIT=dev
